snippet ! Basic script template
	#!/usr/bin/env bash
	set -euo pipefail
	$0
snippet if if block
	if ${1:condition}; then
		$0
	fi
snippet elif elif block
	elif ${1:condition}; then
		$0
snippet for for loop
	for ${1:item} in ${2:list}; do
		$0
	done
snippet case case block
	case ${1:word} in
		(${2:pattern}) $0 ;;
	esac
snippet while while loop
	while ${1:condition}; do
		$0
	done
snippet until until loop
	until ${1:condition}; do
		$0
	done
snippet fori for loop with counter
	for (( i = ${1:start}; i < ${2:end}; i++ )); do
		$0
	done
snippet XDG_CACHE_HOME
	\${XDG_CACHE_HOME:-\${HOME}/.cache}
snippet XDG_CONFIG_HOME
	\${XDG_CONFIG_HOME:-\${HOME}/.config}
snippet XDG_DATA_HOME
	\${XDG_DATA_HOME:-\${HOME}/.local/store}
snippet XDG_STATE_HOME
	\${XDG_STATE_HOME:-\${HOME}/.local/state}
snippet timeit measure execution time (in Bash)
	start_time_${1:test}=\$EPOCHREALTIME
	$0
	end_time_${1:test}=\$EPOCHREALTIME
	printf '${1:test}: %s ms\n' "\$(( (10#\${end_time_${1:test}//[^0-9]/} - 10#\${start_time_${1:test}//[^0-9]/}) / 1000 ))" >&2
snippet prof profile_start/profile_stop pair
	profile_start "${1:test}"
	$0
	profile_stop "${1:test}"
snippet basename extract file name from path
	\${${1:path}##*/}
snippet dirname extract directory path
	\${${1:path}%/*}
snippet setoptlocal
	setopt local_options $0
