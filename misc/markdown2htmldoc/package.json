{
  "private": true,
  "name": "markdown2htmldoc",
  "bin": "main.js",
  "engines": {
    "node": ">=8.0.0"
  },
  "scripts": {
    "build:themes": "sass --no-source-map --style=compressed --pkg-importer=node --quiet-deps --silence-deprecation=import themes-src/:themes-out/",
    "test": "vitest",
    "lint": "eslint . --ext .js,.mjs",
    "check:types": "tsc --noEmit",
    "check:fmt": "prettier --check '**/*.{js,mjs}'"
  },
  "dependencies": {
    "argparse": "^3.0.0",
    "github-markdown-css": "^5.5.0",
    "github-slugger": "^1.5.0",
    "markdown-it": "^15.0.3",
    "markdown-it-emoji": "^3.0.0",
    "prismjs": "^1.30.0"
  },
  "devDependencies": {
    "@types/github-slugger": "^1.3.0",
    "@types/node": "^26.1.1",
    "@types/prismjs": "^1.26.6",
    "eslint": "^8.56.0",
    "eslint-config-dmitmel": "dmitmel/eslint-config-dmitmel#semver:^9.0.2",
    "eslint-plugin-n": "^18.2.2",
    "normalize.css": "^8.0.1",
    "prettier": "^3.2.4",
    "sass": "^1.70.0",
    "typescript": "^6.0.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
