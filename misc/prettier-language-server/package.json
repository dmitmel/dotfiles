{
  "private": true,
  "name": "prettier-language-server",
  "version": "0.1.0",
  "bin": "./main.js",
  "engines": {
    "node": ">=12.2.0"
  },
  "scripts": {
    "lint": "eslint . --ext .js,.mjs",
    "check:types": "tsc --noEmit",
    "check:fmt": "prettier --check '**/*.{js,mjs}'"
  },
  "dependencies": {
    "prettier": "^3.0.0",
    "vscode-languageserver": "^9.0.0",
    "vscode-languageserver-textdocument": "^1.0.0",
    "vscode-uri": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "eslint": "^8.57.1",
    "eslint-config-dmitmel": "dmitmel/eslint-config-dmitmel#semver:^9.0.1",
    "eslint-plugin-n": "^18.5.0"
  }
}
